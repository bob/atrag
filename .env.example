# Optional for local preparation; required when creating embeddings.
OPENAI_API_KEY=
# Accepted CIRS profile; small missed one Russian semantic case.
OPENAI_EMBEDDING_MODEL=text-embedding-3-large
OPENAI_EMBEDDING_DIMENSIONS=1536

# Use an existing local PostgreSQL server. Replace credentials/database as needed.
DATABASE_URL=postgresql://atrag:change-me@localhost:5432/atrag
ATRAG_DATA_DIR=./data
ATRAG_EMBEDDING_BATCH_SIZE=32
ATRAG_CHUNK_TARGET_TOKENS=700
ATRAG_CHUNK_MAX_TOKENS=1200

# Chat model; documents and versions are selected through database records.
ATRAG_CHAT_MODEL=gpt-6-luna

# Comma-separated verified Google emails; empty disables administrator access.
# The Streamlit allowed_emails policy still applies to administrators.
ATRAG_ADMIN_EMAILS=
